NEXT_PUBLIC_SITE_URL=https://crikket.io
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true

# Server-only. Base URL server components use to reach the API, bypassing
# the public hostname. Defaults to http://localhost:3000, correct whenever
# web and server share a network namespace (e.g. network_mode: service:server).
# Only override if the server listens on a different internal address.
AUTH_INTERNAL_URL=

# Posthog (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Crikket Capture (optional)
NEXT_PUBLIC_CRIKKET_KEY=
